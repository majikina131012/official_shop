<h2>NEWS</h2>
<table>
  <% @informations.each do |information| %>
    <tr>
      <th>
      <%= link_to information_path(information.id) do %>
        <%= information.title %>
      <% end %>
      <td><%= information.body %></td>
      </th>
    </tr>
  <% end %>
</table>
<h2>GOODS</h2>
<table>
  <thead>
    <tr>
      <th></th>
      <th>グッズ名</th>
      <th>価格(税込)</th>
      <th>販売ステータス</th>
    </tr>
  </thead>
  <% @goods.each do |good| %>
  <tbody>
    <tr>
      <td><%= image_tag good.get_item_image(100,100) %></td>
      <td><%= good.name %></td>
      <td><%= good.price_without_tax %>(<%= good.with_tax_price %>)</td>
      <td><%= good.status_i18n %></td>
    </tr>
  </tbody>
  <% end %>
</table>
<%= paginate @goods, param_name: :goods_page %>
<h2>CD</h2>
<table>
  <thead>
    <tr>
      <th></th>
      <th>CD名</th>
      <th>価格(税込)</th>
      <th>販売ステータス</th>
    </tr>
  </thead>
  <% @CDs.each do |cd| %>
  <tbody>
    <tr>
      <td><%= image_tag cd.get_item_image(100,100) %></td>
      <td><%= cd.name %></td>
      <td><%= cd.price_without_tax %>(<%= cd.with_tax_price %>)</td>
      <td><%= cd.status_i18n %></td>
    </tr>
  </tbody>
  <% end %>
</table>
<%= paginate @goods, param_name: :cds_page %>
